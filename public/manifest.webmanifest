{
  "name": "Umpire Polo Assistant",
  "short_name": "Umpire",
  "description": "Offline polo rulebook assistant for umpires",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f3f5f8",
  "theme_color": "#071b36",
  "icons": [
    {
      "src": "/logo.svg",
      "sizes": "any",
