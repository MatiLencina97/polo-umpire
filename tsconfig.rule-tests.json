{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ],
    "rootDir": ".",
    "outDir": ".rule-test-build",
    "noEmit": false
  },
  "include": [
    "scripts/rule-regression-tests.ts",
    "lib/types.ts",
    "lib/engine.ts",
    "lib/play-decision.ts",
    "lib/subarticles.ts",
    "lib/cross-rule.ts",
    "lib/match-flow.ts",
    "lib/external-resources.ts",
    "lib/case-history.ts",
    "lib/voice.ts",
    "lib/official-guidance.ts",
    "lib/decision-audit.ts",
    "lib/row-entitlement.ts",
    "lib/decision-links.ts",
    "lib/complex-rules.ts",
    "lib/decision-feedback.ts",
    "lib/browser-storage.ts",
    "lib/event-profile.ts"
  ]
}
